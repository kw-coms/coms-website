# Frontend
VITE_API_BASE_URL=/api
PUBLIC_BASE_URL=https://coms.kw.ac.kr

# Sentry error reporting (optional — leave VITE_SENTRY_DSN blank to disable).
# Mirrors the coms-member-app observability setup.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production

# Backend
SERVER_PORT=8080
JWT_SECRET=change-me

DB_NAME=comsdb
DB_USER=coms
DB_PASSWORD=change-me

MAIL_ENABLED=false
MAIL_LOG_VERIFICATION_CODES=false
MAIL_FROM=no-reply@coms.kw.ac.kr
RECRUIT_MAIL_TO=kwcoms69@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

CORS_ALLOWED_ORIGINS=http://localhost:5173,https://coms.kw.ac.kr,http://coms.kw.ac.kr,https://main.d2y2jv10z2f3v2.amplifyapp.com,https://localhost,capacitor://localhost

# --- Capacitor mobile app cross-site cookie auth ---
# The Android/iOS Capacitor app runs on origin https://localhost (Android) or
# capacitor://localhost (iOS) and calls coms.kw.ac.kr/api cross-site.
# For HttpOnly session cookies to be accepted cross-site by the mobile WebView:
#   - CORS_ALLOWED_ORIGINS must include both capacitor origins above.
#   - Cookies must be SameSite=None and Secure (HTTPS-only).
# WARNING: SameSite=None REQUIRES COOKIE_SECURE=true. Never set None on plain HTTP.
# These values are safe for production (HTTPS). Do NOT use None/true in plain-HTTP dev
# environments; the backend dev profile defaults (Lax / secure=true) handle local dev.
COOKIE_SAME_SITE=None
COOKIE_SECURE=true

# Shared HMAC secret for server-to-server integrations (e.g. Saturday Food Club invites).
# Must be at least 32 characters. Leave blank to disable /api/integrations/**.
INTEGRATION_HMAC_SECRET=

# --- Backend Sentry error reporting (optional) ---
# Leave SENTRY_DSN blank to disable (Sentry's default no-op behavior).
# To enable: paste the backend project DSN from Sentry (Settings -> Projects -> Client Keys).
SENTRY_DSN=
SENTRY_ENV=production

# --- Mobile push notifications (Firebase Cloud Messaging) ---
# Disabled by default. Push is a no-op until BOTH of the following are true:
#   1) PUSH_ENABLED=true
#   2) FIREBASE_CREDENTIALS_PATH points to a readable Firebase service-account JSON.
# To actually enable push:
#   - In the Firebase console (Project settings -> Service accounts), generate a new
#     private key. This downloads a service-account JSON.
#   - Mount that file into the backend container (see the commented volume in
#     docker-compose.yml) and set FIREBASE_CREDENTIALS_PATH to its in-container path,
#     e.g. /app/secrets/firebase-service-account.json
#   - The mobile app must ship its own google-services.json (Android) /
#     GoogleService-Info.plist (iOS) and register device tokens via
#     POST /api/mobile/v1/push-tokens.
PUSH_ENABLED=false
FIREBASE_CREDENTIALS_PATH=

# Initial deploy: update
# Stable production with migrations: validate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
