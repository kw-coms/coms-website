FROM node:24-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Sentry DSN must be baked at build time (Vite inlines import.meta.env.VITE_* into the
# static bundle; runtime container env cannot inject it). Blank = Sentry stays disabled.
ARG VITE_SENTRY_DSN=
ARG VITE_SENTRY_ENV=production
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_SENTRY_ENV=$VITE_SENTRY_ENV

RUN npm run build


FROM nginx:1.27-alpine

COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
