FROM node:24-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Every VITE_* value must be baked at build time (Vite inlines import.meta.env.VITE_* into the
# static bundle; runtime container env cannot inject it), and each one is passed in as a build
# argument. They used to reach the build because `COPY . .` brought the server's .env along —
# together with the database password, JWT secret and SMTP password in that same file. .env is
# now excluded by .dockerignore, so a variable that is not declared here is simply absent from
# the bundle; tests/frontendBuildEnv.test.mjs fails when one is missing.
#
# Blank Sentry DSN = Sentry stays disabled. Blank API base = same-origin /api. Any blank
# Firebase value = web push hides itself.
ARG VITE_API_BASE_URL=
ARG VITE_SENTRY_DSN=
ARG VITE_SENTRY_ENV=production
ARG VITE_FIREBASE_API_KEY=
ARG VITE_FIREBASE_PROJECT_ID=
ARG VITE_FIREBASE_APP_ID=
ARG VITE_FIREBASE_MESSAGING_SENDER_ID=
ARG VITE_FIREBASE_VAPID_KEY=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_SENTRY_ENV=$VITE_SENTRY_ENV
ENV VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY
ENV VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID
ENV VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID
ENV VITE_FIREBASE_MESSAGING_SENDER_ID=$VITE_FIREBASE_MESSAGING_SENDER_ID
ENV VITE_FIREBASE_VAPID_KEY=$VITE_FIREBASE_VAPID_KEY

# Sentry source map upload (optional). Only uploads when SENTRY_AUTH_TOKEN is
# non-empty; otherwise the @sentry/vite-plugin is skipped and the build is a
# normal no-upload build. ORG/PROJECT fall back to vite.config.js defaults.
# These stay build arguments only: RUN sees them as environment variables, but
# unlike ENV they are not written into the stage's image configuration, so the
# auth token is not persisted with the build stage.
ARG SENTRY_AUTH_TOKEN=
ARG SENTRY_ORG=
ARG SENTRY_PROJECT=

RUN npm run build


# Circuit Lab (lab/): a separate Vite app with its own package.json and lockfile, served under /lab/.
# Built on its own so its dependencies (three.js, CodeMirror) never enter the site's build, and the
# site's stage never sees lab/node_modules. Its Arduino compiler is a separate image (docker-compose.yml).
FROM node:24-alpine AS lab-build

WORKDIR /lab

COPY lab/package*.json ./
RUN npm ci

COPY lab/index.html lab/vite.config.ts lab/tsconfig*.json ./
COPY lab/src ./src

# base is /lab/ (lab/vite.config.ts); `tsc -b` type-checks first.
RUN npm run build


# 1.28 is the maintained stable line; the 1.27 mainline no longer gets security fixes.
FROM nginx:1.28-alpine

COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
# Kept outside conf.d/ so nginx's `include conf.d/*.conf` does not load this
# header-only snippet as a standalone server; it is `include`d per-location instead.
COPY security-headers.conf /etc/nginx/security-headers.conf
COPY security-headers-common.conf /etc/nginx/security-headers-common.conf
COPY security-headers-lab.conf /etc/nginx/security-headers-lab.conf
COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=lab-build /lab/dist /usr/share/nginx/html/lab

# Mount point of the volume shared with coms-lab-compiler (docker-compose.yml): a unix socket there
# carries the compile requests. A fresh named volume copies this directory's owner and mode, so it is
# created the same way here and in the compiler image: owned by the compiler's uid 10001, group 101
# (nginx), 0750. The socket the compiler creates is 0660 in that group, which is what the nginx
# workers (uid/gid 101) need to connect.
RUN mkdir -p /run/coms-lab && chown 10001:101 /run/coms-lab && chmod 0750 /run/coms-lab

EXPOSE 80
