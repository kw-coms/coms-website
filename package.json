{
  "name": "coms-website",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run typecheck && npm run lint && npm run test:unit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "lint": "eslint .",
    "gen:circuits": "node --import tsx scripts/gen-circuit-chrome.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "e2e": "cross-env PWA_DISABLE=1 npm run build && playwright test",
    "e2e:update": "cross-env PWA_DISABLE=1 npm run build && playwright test --update-snapshots",
    "smoke": "cross-env PWA_DISABLE=1 npm run build && playwright test --project=smoke",
    "smoke:production": "node scripts/prod-smoke.mjs",
    "test:e2e:backend": "node scripts/e2e-backend.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@sentry/react": "^10.59.0",
    "@tanstack/react-query": "^5.104.5",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
