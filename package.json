{
  "name": "coms-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run typecheck && npm run lint && npm run test:unit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "e2e": "cross-env PWA_DISABLE=1 npm run build && playwright test",
    "e2e:update": "cross-env PWA_DISABLE=1 npm run build && playwright test --update-snapshots",
    "smoke": "cross-env PWA_DISABLE=1 npm run build && playwright test --project=smoke",
    "smoke:production": "node scripts/prod-smoke.mjs",
    "test:e2e:backend": "node scripts/e2e-backend.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.59.0",
    "@tanstack/react-query": "^5.101.0",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.542.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sentry/vite-plugin": "^11.9.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0"
  }
}
